PORT=5000
NODE_ENV=development
MONGO_URI=your_mongodb_uri
JWT_SECRET=your_jwt_secret
JWT_EXPIRE=30d

# Frontend origin used to build clickable links inside notification emails (Notification.link is
# stored relative - see backend/src/models/Notification.js). Point this at the real web-app origin
# in production.
WEB_APP_URL=http://localhost:3000

# Email delivery (backend/src/services/emailNotificationService.js) - all four required for real
# SMTP delivery. Leave unset in development and it falls back to an auto-created Ethereal test
# account (nodemailer's fake-inbox service): emails never reach a real inbox, but each send logs a
# preview URL to view it. A real production deploy MUST set these to an actual SMTP provider
# (SendGrid, SES, Postmark, etc.) or notification emails will silently go nowhere real.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# SMTP_FROM=notifications@cricroots.com
# SMTP_SECURE=false
